# Mobile development
android-sdk/-e 
# Environment and credential files
.env
.env.*
*.env
credentials.json
*.pem
*.key
.credentials

# One narrow exception to *.pem above. This is a SERVER'S PUBLIC CERTIFICATE — the same
# bytes apimacuat.zyncbook.com hands to every client that connects — not a private key, and
# it is checked for that (no PRIVATE KEY block). The app must trust it to reach the Boost
# payment routes, so the Android build needs it as a resource.
#
# The blanket rule silently swallowed it once: the APK built fine locally because the file
# was on disk, and CI failed with "resource raw/uat_apimacuat not found". Keep the blanket
# rule; keep this exception narrow.
!flutter_app/android/app/src/main/res/raw/uat_apimacuat.pem
-e 
# Environment and credential files
.env
.env.*
*.env
credentials.json
*.pem
*.key
.credentials

# One narrow exception to *.pem above. This is a SERVER'S PUBLIC CERTIFICATE — the same
# bytes apimacuat.zyncbook.com hands to every client that connects — not a private key, and
# it is checked for that (no PRIVATE KEY block). The app must trust it to reach the Boost
# payment routes, so the Android build needs it as a resource.
#
# The blanket rule silently swallowed it once: the APK built fine locally because the file
# was on disk, and CI failed with "resource raw/uat_apimacuat not found". Keep the blanket
# rule; keep this exception narrow.
!flutter_app/android/app/src/main/res/raw/uat_apimacuat.pem
-e 
# Environment and credential files
.env
.env.*
*.env
credentials.json
*.pem
*.key
.credentials

# One narrow exception to *.pem above. This is a SERVER'S PUBLIC CERTIFICATE — the same
# bytes apimacuat.zyncbook.com hands to every client that connects — not a private key, and
# it is checked for that (no PRIVATE KEY block). The app must trust it to reach the Boost
# payment routes, so the Android build needs it as a resource.
#
# The blanket rule silently swallowed it once: the APK built fine locally because the file
# was on disk, and CI failed with "resource raw/uat_apimacuat not found". Keep the blanket
# rule; keep this exception narrow.
!flutter_app/android/app/src/main/res/raw/uat_apimacuat.pem
# Same kind of exception: the PUBLIC Sectigo R46 root CA certificate the app trusts so older
# Android phones can load member photos (lib/services/extra_trust.dart).
!flutter_app/assets/certs/sectigo_public_server_authentication_root_r46.pem

# Flutter/Dart build cache. `.dart_tool/chrome-device/` is a full Chrome PROFILE — it
# contains Cookies, Login Data and Trust Tokens SQLite databases. 153 of those files were
# committed to this repo; the credential tables happened to be empty, but a dev session
# that signs in anywhere would populate them and they would be committed next time.
.dart_tool/
**/.dart_tool/

# Editor settings stay local, but the shared run configuration is committed — it replaced
# the tool-specific .claude/launch.json and is how the web preview is launched.
# (The rule above must be `.vscode/*`, not `.vscode/`: git does not descend into an ignored
# directory, so a negation for a file inside one never matches.)
!.vscode/launch.json
